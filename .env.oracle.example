# Copiar como .env.oracle.local para Docker Compose. No subir contrasenas reales.
# Solo ejemplos, sustituir las claves antes del primer arranque.
ORACLE_SYS_PASSWORD=CAMBIAR_CLAVE_SYSTEM_SEGURA
ORACLE_PASSWORD=CAMBIAR_CLAVE_SIGESTEC_SEGURA
# Por defecto 1521. Si ya tienes otro Oracle: 1523 y actualiza ORACLE_URL.
ORACLE_PORT=1521
# Para IntelliJ/DBeaver en la misma PC (editar si cambiaste el puerto):
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ORACLE_USER=SIGESTEC_ADS
# Obligatorio para un JWT persistente entre reinicios (base64 >=48 bytes):
JWT_SECRET_BASE64=CAMBIAR_POR_BASE64_ALEATORIO
# Solo para demostracion en un esquema local de pruebas VACIO:
SIGESTEC_DEMO=false
SIGESTEC_DEMO_PASSWORD=CAMBIAR_CLAVE_DEMO_SEGURA

# Recuperación (configurar en IntelliJ, no compartir credenciales)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sigestec835@gmail.com
# Contrasena de APLICACION de Gmail de 16 caracteres, no la clave habitual.
SMTP_PASSWORD=CAMBIAR_POR_CONTRASENA_DE_APLICACION
SMTP_REMITENTE_EMAIL=sigestec835@gmail.com
SMTP_REMITENTE_NOMBRE=SIGESTEC
SIGESTEC_RECUPERACION_ENABLED=true
SIGESTEC_RECUPERACION_CORREO_PRUEBA=sigestec835@gmail.com
SIGESTEC_FRONTEND_URL=http://localhost:4200
